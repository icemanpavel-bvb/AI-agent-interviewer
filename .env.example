# Скопируйте в .env (Linux/macOS: cp .env.example .env · Windows: Copy-Item .env.example .env).
# Значения ниже — для запуска на своём компьютере без Docker; docker-compose.yml подменяет адреса на свои.
# --- БД (понадобится с этапа 1) ---
DATABASE_URL=postgresql+asyncpg://interviewer:interviewer@localhost:5432/interviewer
# --- безопасность ---
JWT_SECRET=change-me
INVITE_TTL_DAYS=7
# --- LLM ---
LLM_PROVIDER=ollama            # ollama | gigachat | yandexgpt
LLM_MODEL=gigachat-lightning   # ollama cp hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M gigachat-lightning
# Ollama запущена в системе (D-001). В Docker адрес подменяется на host.docker.internal (docker-compose.yml).
OLLAMA_URL=http://localhost:11434
LLM_TEMPERATURE=0
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=400
LLM_WARMUP_ON_START=true
# Настройки самой Ollama (задаются для Ollama, а не здесь): OLLAMA_KEEP_ALIVE=30m, OLLAMA_NUM_PARALLEL=1 — см. README
GIGACHAT_CREDENTIALS=
LLM_MASK_PII=false             # true для внешних провайдеров
# --- сценарии вакансий ---
SCENARIOS_DIR=scenarios
# Страница /demo для тестов и защиты (D-005). В реальной работе — false.
DEMO_MODE=true
# --- интервью ---
MAX_BASE_QUESTIONS=10
MAX_FOLLOWUPS_PER_QUESTION=2
POSTPONE_DAYS_DEFAULT=2
# --- уведомления ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
